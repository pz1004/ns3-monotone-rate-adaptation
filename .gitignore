# ns-3 is not vendored: fetch release 3.48 and verify against env/tarball.sha256.
# An earlier version of this repository committed the whole tree plus the tarball --
# 5,695 files and 187 MB of history for code that is not ours. Do not do it again.
ns-3*/
ns-allinone-*/
*.tar.bz2
*.tar.gz
*.tar.xz

# Build output
build/
cmake-cache/
.lock-ns3*
*.o
*.a
*.so
*.so.*
*.gch
*.ninja
.ninja_deps
.ninja_log
compile_commands.json

# Generated by analysis/ -- derived from results/, never edited by hand
out/

# Manuscript. Not part of this artifact.
paper/
*.pdf
*.tex
*.aux
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
# (logs/*.log IS tracked -- simulation run logs. Only LaTeX aux files are ignored above.)

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp

# Derived plots. The generators write figures to out/; anything rendered into results/
# is a leftover that can go stale against the parquet beside it.
results/**/*.png
